# AI Employee Vault - Environment Variables Template
#
# Copy this file to .env and fill in your credentials
# IMPORTANT: .env is gitignored - never commit credentials
#
# Usage: source .env (or load via python-dotenv in scripts)

# Gmail API (Silver tier)
# Get credentials from https://console.cloud.google.com/
GMAIL_CREDENTIALS_JSON_PATH=/mnt/d/Hackaton-0/AI_Employee_Vault/.watchers/credentials.json
GMAIL_TOKEN_JSON_PATH=/mnt/d/Hackaton-0/AI_Employee_Vault/.watchers/token.json

# WhatsApp (Silver tier, optional)
WHATSAPP_SESSION_DIR=/mnt/d/Hackaton-0/AI_Employee_Vault/.sessions/whatsapp

# LinkedIn (Silver+ tier, optional)
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password-here

# Bank API (Gold tier, optional)
BANK_API_KEY=your-bank-api-key
BANK_ACCOUNT_ID=your-account-id

# Odoo (Gold tier, optional)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Slack Integration (Optional)
SLACK_BOT_TOKEN=xoxb-your-token-here
